{
  "reload_style_on_change": true,
  "exclusive": true,
  "position": "top",
  "spacing": 0,
  "height": 0,
  "width": "100%",
  "margin-top": 4,
  "margin-bottom": 0,
  "margin-right": 4,
  "margin-left": 4,
  "modules-left": ["group/left1", "group/left2", "group/left3", "group/left4"],
  "modules-center": ["clock", "custom/notification"],
  "modules-right": ["group/right1", "group/right"],

  // --- Groups

  "group/left1": {
    "orientation": "inherit",
    "modules": ["custom/os"],
  },

  "group/left2": {
    "orientation": "inherit",
    "modules": ["ext/workspaces"],
  },

  "group/left3": {
    "orientation": "inherit",
    "modules": ["pulseaudio", "network", "group/tray-expander2"],
  },

  "group/left4": {
    "orientation": "inherit",
    "modules": ["mpris"],
  },

  "group/right1": {
    "orientation": "inherit",
    "modules": ["group/tray-expander"],
  },

  "group/right": {
    "orientation": "inherit",
    "modules": ["temperature", "memory", "cpu", "disk", "battery"],
  },

  // --- Left Modules

  "custom/os": {
    "format": "󰣨",
    "on-click-right": "rofi -show drun -theme /home/gentoo/.config/mango/rofi/styles.rasi 2>/dev/null",
    "on-click": "wlogout -c /home/gentoo/.config/mango/wlogout/style.css -l /home/gentoo/.config/mango/wlogout/layout",
    "tooltip-format": "Super + Space",
  },

  "ext/workspaces": {
    "format": "{name}",
    "ignore-hidden": true,
    "on-click": "activate",
    "on-click-right": "deactivate",
    "sort-by-id": true,
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "on-click": "foot -e pulsemixer",
    "on-click-right": "pulsemixer --toggle-mute",
    "on-scroll-up": "pulsemixer --change-volume +5 --max-volume 100",
    "on-scroll-down": "pulsemixer --change-volume -5",
    "tooltip-format": "{desc}",
    "scroll-step": 5,
    "format-muted": " muted",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": ["", "", ""],
    },
  },

  "network": {
    "family": "ipv4",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "Ethernet: {ifname}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "foot -e /home/gentoo/.cargo/bin/impala",
  },

  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "interval": 5,
    "tooltip-format": "Devices connected: {num_connections}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "on-click": "/home/gentoo/.local/bin/rofi-bluetooth -theme /home/gentoo/.config/mango/rofi/styles.rasi",
  },

  "backlight": {
    "device": "amdgpu_bl1",
    "rotate": 0,
    "format": "{icon}",
    "tooltip-format": "󰳲 {percent}%",
    "format-icons": ["󰃜", "󰃝", "󰃞", "󰃟", "󰃠"],
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-",
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "performance": "",
      "balanced": "",
      "power-saver": "",
    },
  },

  "custom/updatespacman": {
    "format": "{icon}",
    "return-type": "json",
    "format-icons": {
      "has-updates": "󰏖!",
      "updated": "",
    },
    "exec-if": "which waybar-module-pacman-updates",
    "exec": "waybar-module-pacman-updates --no-zero-output",
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": "󰾫",
    },
  },

  "custom/nightlight": {
    "format": "{}",
    "return-type": "json",
    "exec": "/home/gentoo/.local/bin/mango-nightlight status",
    "interval": 2,
    "on-click": "/home/gentoo/.local/bin/mango-nightlight toggle",
    "tooltip": true,
  },

  "mpris": {
    "format": "{status_icon} {artist} - {title}",
    "format-paused": "<span color='grey'>{status_icon} {artist} - {title}</span>",
    "max-length": 30,
    "status-icons": {
      "playing": "󰎇",
      "paused": "",
      "stopped": "",
    },
    "ignored-players": [],
  },

  // --- Center Modules

  "clock": {
    "format": "{:%a %d ｜ %H:%M}",
    "format-alt": "{:L%d %B %Y}",
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-click-right": "mode",
      "format": {
        "month": "<span color='#ffead3'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>",
      },
    },
    "on-click-right": "foot -e tzselect",
  },

  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "",
      "dnd-none": "󰪑",
      "inhibited-notification": "󰅸",
      "inhibited-none": "󰂜",
      "dnd-inhibited-notification": "",
      "dnd-inhibited-none": "󰪑",
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "sleep 0.1s && swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
  },

  // --- Right Modules

  "temperature": {
    "critical-threshold": 80,
    "warning-threshold": 60,
    "format": " {temperatureC}°C",
    "format-critical": " {temperatureC}°C",
    "format-warning": " {temperatureC}°C",
    "tooltip-format": "CPU: {temperatureC}°C / {temperatureF}°F / {temperatureK}°K",
  },

  "memory": {
    "interval": 5,
    "format": " {used:0.1f}G",
    "tooltip-format": "{used:0.1f}GiB used of {total:0.1f}GiB",
  },

  "cpu": {
    "interval": 5,
    "format": " {usage}%",
  },

  "disk": {
    "interval": 30,
    "format": "󰋊 {specific_used:0.2f}GB",
    "unit": "GB",
    "on-click": "foot -e ncdu /",
    "tooltip-format": "{specific_free:0.2f} GB of {specific_total:0.2f} GB available ({percentage_used}% used)",
  },

  "battery": {
    "format": "{icon} {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    },
    "format-full": "󰁹 {capacity}%",
    "interval": 5,
    "on-click": "notify-send -u low \"$(upower -i /org/freedesktop/UPower/devices/battery_BATT | grep -E 'state|percentage|time to'| sed 's/^[ \t]*//')\"",
    "states": {
      "warning": 20,
      "critical": 10,
    },
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%\nHealth: {health}% ({cycles} cycles)\n{timeTo}",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%\nHealth: {health}% ({cycles} cycles)\n{timeTo}",
  },

  // --- Tray & Expanders

  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item",
    },
    "modules": ["custom/expand-icon", "tray"],
  },

  "custom/expand-icon": {
    "format": "",
    "tooltip": false,
  },

  "tray": {
    "icon-size": 11,
    "show-passive-items": true,
    "spacing": 5,
  },

  "group/tray-expander2": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item",
      "transition-left-to-right": true,
    },
    "modules": [
      "custom/expand-icon2",
      "bluetooth",
      "backlight",
      "power-profiles-daemon",
      "idle_inhibitor",
      "custom/nightlight",
    ],
  },

  "custom/expand-icon2": {
    "format": "",
    "tooltip": false,
  },
}
