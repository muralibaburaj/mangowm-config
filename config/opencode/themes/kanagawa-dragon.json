{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "purple",
      "blue",
      "cyan",
      "yellow",
      "orange",
      "red",
      "gray"
    ],
    "text": {
      "base": "#c5c9c5",
      "muted": "#a6a69c",
      "action": {
        "primary": {
          "base": "#181616"
        },
        "secondary": {
          "base": "#a6a69c"
        },
        "destructive": {
          "base": "#c4746e"
        }
      },
      "formfield": {
        "base": "#c5c9c5"
      },
      "feedback": {
        "error": {
          "base": "#c4746e",
          "muted": "#a6a69c"
        },
        "warning": {
          "base": "#e6c384",
          "muted": "#a6a69c"
        },
        "success": {
          "base": "#a292a3",
          "muted": "#a6a69c"
        },
        "info": {
          "base": "#7fb4ca",
          "muted": "#a6a69c"
        }
      }
    },
    "background": {
      "base": "#181616",
      "raised": {
        "base": "#0d0c0c",
        "high": "#282727",
        "max": "#3c3836"
      },
      "action": {
        "primary": {
          "base": "#a292a3"
        },
        "secondary": {
          "base": "#282727"
        },
        "destructive": {
          "base": "#c4746e"
        }
      },
      "formfield": {
        "base": "#0d0c0c"
      },
      "feedback": {
        "error": {
          "base": "#452735"
        },
        "warning": {
          "base": "#453b36"
        },
        "success": {
          "base": "#3c3153"
        },
        "info": {
          "base": "#283b4e"
        }
      }
    },
    "border": {
      "base": "#282727"
    },
    "scrollbar": {
      "base": "#3c3836"
    },
    "diff": {
      "text": {
        "added": "#a292a3",
        "removed": "#c4746e",
        "context": "#c5c9c5",
        "hunkHeader": "#a292a3"
      },
      "background": {
        "added": "#3c3153",
        "removed": "#452735",
        "context": "#181616"
      },
      "highlight": {
        "added": "#57416e",
        "removed": "#5a3646"
      },
      "lineNumber": {
        "text": "#727169",
        "background": {
          "added": "#3c3153",
          "removed": "#452735"
        }
      }
    },
    "syntax": {
      "comment": "#727169",
      "keyword": "#a292a3",
      "function": "#7e9cd8",
      "variable": "#c5c9c5",
      "string": "#a292a3",
      "number": "#b6927b",
      "type": "#e6c384",
      "operator": "#7fb4ca",
      "punctuation": "#c8c093"
    },
    "markdown": {
      "text": "#c5c9c5",
      "heading": "#7e9cd8",
      "link": "#7e9cd8",
      "linkText": "#7e9cd8",
      "code": "#a292a3",
      "blockQuote": "#727169",
      "emphasis": "#c5c9c5",
      "strong": "#c5c9c5",
      "horizontalRule": "#282727",
      "listItem": "#a292a3",
      "listEnumeration": "#b6927b",
      "image": "#a292a3",
      "imageText": "#a292a3",
      "codeBlock": "#181616"
    }
