#!/usr/bin/env python3
"""Display the interface selected by the kernel, not cached Wi-Fi events."""
import html
import json
from pathlib import Path
import re
import subprocess

WIFI_ICONS = ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"]


def command(argv):
    try:
        result = subprocess.run(argv, capture_output=True, text=True, timeout=2)
        return result.stdout if result.returncode == 0 else ""
    except (OSError, subprocess.TimeoutExpired):
        return ""


def current_route():
    # `route get` is a local kernel lookup; it sends no packets to these IPs.
    for family, address in [("-4", "1.1.1.1"), ("-6", "2606:4700:4700::1111")]:
        try:
            routes = json.loads(command(["ip", "-j", family, "route", "get", address]) or "[]")
        except (ValueError, TypeError):
            continue
        if routes and routes[0].get("dev") not in (None, "lo"):
            return routes[0]
    return {}


def display(route, wireless=False, station=""):
    interface = route.get("dev")
    if not interface:
        return {"text": "󰤮", "class": "disconnected", "tooltip": "Disconnected"}
    address = route.get("prefsrc", route.get("src", ""))
    tooltip = ("Wi-Fi" if wireless else "Ethernet") + ": " + interface
    if address:
        tooltip += "\nIP: " + address
    icon = "󰈀"
    if wireless:
        station = re.sub(r"\x1b\[[0-9;]*m", "", station)
        network = re.search(r"^\s*Connected network\s+(.+?)\s*$", station, re.MULTILINE)
        signal = re.search(r"^\s*RSSI\s+(-?\d+)\s+dBm", station, re.MULTILINE)
        strength = max(0, min(100, 2 * (int(signal[1]) + 100))) if signal else 50
        icon = WIFI_ICONS[min(4, strength // 25)]
        if network:
            tooltip += "\n" + network[1]
        if signal:
            tooltip += "\nSignal: " + signal[1] + " dBm"
    return {"text": icon, "class": "wifi" if wireless else "ethernet", "tooltip": html.escape(tooltip)}


def main():
    route = current_route()
    interface = route.get("dev", "")
    base = Path("/sys/class/net") / interface
    wireless = bool(interface) and ((base / "wireless").exists() or (base / "phy80211").exists())
    station = command(["iwctl", "station", interface, "show"]) if wireless else ""
    print(json.dumps(display(route, wireless, station), ensure_ascii=False))


if __name__ == "__main__":
    main()
